{
  "openapi": "3.1.0",
  "info": {
    "title": "KDIGO CKD Risk Heatmap API",
    "version": "3.1.0",
    "description": "KDIGO 2024 GFR–albuminuria risk grouping. Not a CKD diagnosis; optional audit endpoint is a demonstration."
  },
  "paths": {
    "/api/classify": {
      "post": {
        "summary": "KDIGO 2024 eGFR/ACR risk category",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "egfr",
                  "acr_mg_g"
                ],
                "properties": {
                  "egfr": {
                    "type": "number",
                    "minimum": 0,
                    "description": "mL/min/1.73 m²"
                  },
                  "acr_mg_g": {
                    "type": "number",
                    "minimum": 0,
                    "description": "mg/g"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "GFR stage, albuminuria stage, and four-tier risk classification"
          },
          "422": {
            "description": "Input validation error"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Server health",
        "responses": {
          "200": {
            "description": "Status and version"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "JSON process-local counters",
        "responses": {
          "200": {
            "description": "Counters and status as JSON"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Demonstration rule-based audit; requires signing key",
        "responses": {
          "200": {
            "description": "In-process audit dossier"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Mock-only supervisor response",
        "responses": {
          "200": {
            "description": "Deterministic mock response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Process-local audit ledger and integrity result",
        "responses": {
          "200": {
            "description": "HMAC-checked ledger entries; unauthenticated demo endpoint"
          }
        }
      }
    }
  }
}
