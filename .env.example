# Environment variables for kdigo-ckd-heatmap-classifier
# Copy this file to .env and set your own values

# HMAC-SHA256 audit trail signing key (min 16 chars, use a cryptographically random value)
AUDIT_SECRET_KEY=change-me-to-a-random-secret-key-min-16-chars

# LLM provider: mock, ollama, claude, openai
MODEL_PROVIDER=mock
